# Copie este arquivo para .env e preencha. NUNCA publique o .env no GitHub.

# String de conexão do Neon (painel do projeto > Connect)
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require

# Chave da API Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

PORT=3000
